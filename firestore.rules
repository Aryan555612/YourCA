rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User documents ─────────────────────────────────────────────────────
    // Each user can only read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // ── Transactions sub-collection ──────────────────────────────────────
      // Only the owning user can read/write/delete their transactions.
      match /transactions/{txId} {
        allow read, write, delete: if request.auth != null
                                   && request.auth.uid == userId;

        // Validate transaction write data
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.keys().hasAll([
                           'user_id', 'amount', 'type', 'category',
                           'merchant', 'date', 'source', 'created_at'
                         ])
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.type in ['debit', 'credit']
                      && request.resource.data.source in [
                           'sms', 'manual', 'statement_import', 'aa'
                         ];
      }

      // ── Merchant corrections sub-collection ─────────────────────────────
      match /merchantCorrections/{merchantKey} {
        allow read, write, delete: if request.auth != null
                                   && request.auth.uid == userId;
      }

      // ── Balance snapshots sub-collection ────────────────────────────────
      // Stores bank balance viewed by the user, synced from SMS.
      // Only the owning user can read/write their snapshots.
      match /balanceSnapshots/{snapshotId} {
        allow read, write, delete: if request.auth != null
                                   && request.auth.uid == userId;
      }

      // ── Savings plans sub-collection ─────────────────────────────────────
      match /savingsPlans/{planId} {
        allow read, write, delete: if request.auth != null
                                   && request.auth.uid == userId;
      }

      // ── Activity log sub-collection ──────────────────────────────────────
      // Records all user actions (screen views, transactions, etc.)
      // Only the owning user can read/write their activity log.
      match /activityLog/{logId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // ── OTP verification documents (Secure OTP verification by Document ID) ──
    match /otps/{otpDocId} {
      // Anyone can create/read/update/delete single OTP doc by ID, but NO ONE can list all OTPs.
      allow get, create, update, delete: if true;
      allow list: if false;
    }

    // ── Stable user ID mapping (email → consistent SQLite user_id) ──────────
    // Anyone can read their own stable ID (needed after reinstall).
    // First write creates the ID; subsequent writes update timestamp only.
    match /user_stable_ids/{email} {
      allow read: if true; // Public read so we can look up by email
      allow create, update: if true; // First-time creation & lookup (unauthenticated)
    }

    // ── Firebase UID → Stable UID mapping (for future cloud sync) ───────────
    match /firebase_uid_map/{firebaseUid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == firebaseUid;
    }

    // ── Brevo / App Config (read-only for app email notifications) ─────────
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Deny all other access ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

